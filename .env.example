# Encryption Key for System Prompts (Required, 64 character hex)
# DO NOT share this key as it's used to decrypt sensitive system prompts
SYSTEM_PROMPT_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Developer key: used when "Use developer key" is on in Settings.
# Routes to Anthropic claude-fable-5-1 (see DEV_KEY_MODEL in lib/constants.js).
ANTHROPIC_API_KEY=sk-ant-...

MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY_HERE
